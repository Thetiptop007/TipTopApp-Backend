{
  "name": "tiptop-backend",
  "version": "1.0.0",
  "type": "commonjs",
  "packageManager": "pnpm@10.33.0",
  "description": "The-Tip-Top Restaurant Backend API",
  "main": "server.js",
  "nodemonConfig": {
    "watch": [
      "server.js",
      "src",
      ".env"
    ],
    "ignore": [
      "node_modules",
      "logs"
    ],
    "ext": "js,json,env",
    "delay": 250
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --exec \"node --input-type=commonjs\" server.js",
    "start": "node --input-type=commonjs server.js",
    "test": "jest --coverage --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "seed": "node scripts/seed.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop tiptop-backend",
    "pm2:restart": "pm2 restart tiptop-backend",
    "pm2:logs": "pm2 logs tiptop-backend"
  },
  "keywords": [
    "restaurant",
    "food-delivery",
    "api",
    "express",
    "mongodb"
  ],
  "author": "The-Tip-Top Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.4.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "resend": "^6.9.1",
    "socket.io": "^4.8.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  }
}
